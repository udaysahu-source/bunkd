rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }
    
    // User document configurations
    match /users/{userId} {
      // Protect user settings. Only authenticated non-anonymous users can read/write their own settings.
      match /settings/{settingId} {
        allow read, write: if request.auth != null 
          && request.auth.uid == userId 
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      
      // Protect user attendance. Only authenticated non-anonymous users can read/write their own attendance data.
      match /attendance/{recordId} {
        allow read, write: if request.auth != null 
          && request.auth.uid == userId 
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
    }
  }
}
